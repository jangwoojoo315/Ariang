# 실제 배포된 백엔드 서버 (Railway)
NEXT_PUBLIC_API_BASE_URL=https://airang-backend-production.up.railway.app

# 실서버 연결로 MSW 목은 비활성화. 다시 목으로 돌리려면 아래 주석 해제.
# NEXT_PUBLIC_API_MOCKING=enabled

# 카카오 로그인 시작 URL. 백엔드 OAuth 시작 경로를 확정해 설정하세요.
# (Spring Security 기본값 예시 — 실제 경로는 백엔드에 확인)
# NEXT_PUBLIC_KAKAO_AUTH_URL=https://airang-backend-production.up.railway.app/oauth2/authorization/kakao

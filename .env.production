# 실제 백엔드가 없는 배포(데모)에서 MSW 목을 켜기 위한 플래그.
# 추후 실제 API 서버가 준비되면 이 값을 제거/false 처리하고
# NEXT_PUBLIC_API_BASE_URL을 실제 서버로 설정하세요.
NEXT_PUBLIC_API_MOCKING=enabled

# 카카오 로그인 시작 URL. 백엔드 확정 후 Vercel 프로젝트 환경변수에 설정하세요.
# (대시보드 값이 이 파일보다 우선 적용됨)
# NEXT_PUBLIC_KAKAO_AUTH_URL=https://api.example.com/oauth2/authorization/kakao

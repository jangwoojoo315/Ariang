# 실제 배포된 백엔드 서버 (Railway)
NEXT_PUBLIC_API_BASE_URL=https://airang-backend-production.up.railway.app

# 카카오 로그인 시작 URL (백엔드 제공)
NEXT_PUBLIC_KAKAO_AUTH_URL=https://airang-backend-production.up.railway.app/api/auth/kakao/authorize

# [임시] 운영에서도 동작 확인용으로 MSW 목 활성화.
# 내 여행(MyTour)만 목 처리, 나머지(홈·검색)는 실서버로 통과.
# 백엔드가 준비되면 이 줄을 제거하세요.
NEXT_PUBLIC_API_MOCKING=enabled
